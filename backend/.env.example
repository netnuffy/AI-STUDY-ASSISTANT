# App — copy to .env for local dev; on Railway, set these as variables
# in the service's Variables tab instead (never commit a real .env).
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# Database
# Local: the Postgres from docker-compose.yml.
# Railway: add the PostgreSQL plugin, then set
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
# The app rewrites postgres:// / postgresql:// to postgresql+psycopg://
# automatically (see core/config.py), so the plugin's URL works as-is.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/study_assistant

# ChromaDB (vector store)
# CHROMA_MODE=local -> embedded, stored in CHROMA_PERSIST_DIR (default)
# CHROMA_MODE=http  -> connect to a Chroma server (see docker-compose.yml)
CHROMA_MODE=local
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_HOST=localhost
CHROMA_PORT=8000

# Google Gemini — get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# JWT — generate a strong random secret for production:
#   openssl rand -hex 32
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25

# CORS (JSON list) — add your frontend's production URL on Railway, e.g.
# CORS_ORIGINS=["https://your-app.vercel.app"]
CORS_ORIGINS=["http://localhost:3000"]

# --- Railway only (set as service variables) ---
# Railway injects PORT automatically; the server listens on it.
# Persistent data: Railway's filesystem is ephemeral, so attach a Volume
# mounted at /app/data and point both directories at it:
#   UPLOAD_DIR=/app/data/uploads
#   CHROMA_PERSIST_DIR=/app/data/chroma_data
# Also set ENVIRONMENT=production.
