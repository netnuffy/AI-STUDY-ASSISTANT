# Production environment variables for the Vercel deployment.
# Set these in the Vercel dashboard (Project → Settings → Environment
# Variables) — do NOT commit a real .env.production file.
#
# NEXT_PUBLIC_API_URL — the deployed FastAPI backend (no trailing slash).
# Get the URL from Railway: your API service → Settings → Networking →
# Generate Domain. The API lives under /api/v1.
NEXT_PUBLIC_API_URL=https://your-api.up.railway.app/api/v1

# IMPORTANT: NEXT_PUBLIC_ variables are baked into the JavaScript bundle at
# BUILD time. Changing this value in the dashboard does nothing until you
# redeploy (Deployments → ⋯ → Redeploy).
#
# After the first Vercel deploy, also update the backend's CORS_ORIGINS on
# Railway to include your Vercel URL, e.g.:
#   CORS_ORIGINS=["https://your-app.vercel.app"]
