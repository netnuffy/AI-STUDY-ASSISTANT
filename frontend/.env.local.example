# Local development: copy to .env.local (git-ignored).
# URL of the FastAPI backend (no trailing slash). The backend must allow this
# origin in CORS — the default backend config allows http://localhost:3000.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# For production (Vercel), see .env.production.example — the value is set in
# the Vercel dashboard, not in a file.
